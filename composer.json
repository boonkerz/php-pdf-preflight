{
    "name": "boonkerz/php-pdf-preflight",
    "description": "Preflight for PDF print data: configurable rule engine (page size, boxes, bleed, fonts, colours, image resolution) on top of the native pdf_preflight extension",
    "type": "library",
    "license": ["MIT", "Apache-2.0"],
    "keywords": ["pdf", "preflight", "print", "web-to-print", "trimbox", "bleed", "fonts", "dpi", "cmyk", "pdfx"],
    "homepage": "https://github.com/boonkerz/php-pdf-preflight",
    "support": {
        "issues": "https://github.com/boonkerz/php-pdf-preflight/issues",
        "source": "https://github.com/boonkerz/php-pdf-preflight"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-pdf_preflight": "0.1.*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "PrintPreflight\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PrintPreflight\\Tests\\": "php/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0",
            "ext-pdf_preflight": "0.1.0"
        }
    }
}
